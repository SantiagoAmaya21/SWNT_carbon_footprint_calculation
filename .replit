run = "streamlit run app.py --server.port=3000 --server.address=0.0.0.0"
entrypoint = "app.py"

[nix]
channel = "stable-22_11"

[deployment]
run = ["sh", "-c", "streamlit run app.py --server.port=3000 --server.address=0.0.0.0"]
deploymentTarget = "cloudrun"

[env]
VIRTUAL_ENV = "/home/runner/.local/share/virtualenvs/venv"
